# ==============================================================================
# SportRadar Tennis API Credentials
# Sign up and generate key at: https://console.sportradar.com/signup
# ==============================================================================
SPORTRADAR_API_KEY=your_sportradar_api_key_here
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_VERSION=v3
SPORTRADAR_LANGUAGE=en

# Rate limiting (Trial accounts: 1 call per second)
API_REQUEST_DELAY=1.2
API_TIMEOUT=15
API_MAX_RETRIES=3

# ==============================================================================
# MySQL Database Configuration
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tennis_analytics

# Set to true to force local SQLite engine for quick testing without MySQL
FORCE_SQLITE=false
